package {
    default_applicable_licenses: ["external_turbine_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "external_turbine_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

// Common properties shared between turbine-core and turbine.
java_defaults {
    name: "turbine-defaults",
    defaults_visibility: ["//visibility:private"],

    srcs: [
        "java/**/*.java",
    ],

    static_libs: [
        "error_prone_annotations",
        "guava",
        "jspecify",
    ],

    plugins: [
        "auto_value_builder_plugin",
        "auto_value_plugin",
    ],
    libs: [
        "auto_value_annotations",
        "auto_value_memoized_extension_annotations",
    ],

    errorprone: {
        javacflags: [
            "-Xep:NoCanIgnoreReturnValueOnClasses:WARN",
        ],
    },
}

// Core turbine library for tools (such as Metalava) that embed Turbine's parser,
// binder, and type model as a library without the CLI entry point (main),
// bytecode lowering (lower), or protobuf dependency reducer (deps).
java_library_host {
    name: "turbine-core",
    defaults: ["turbine-defaults"],

    exclude_srcs: [
        "java/com/google/turbine/deps/**/*.java",
        "java/com/google/turbine/lower/**/*.java",
        "java/com/google/turbine/main/**/*.java",
    ],

    exported_static_libs: [
        "guava",
        "jspecify",
    ],
}

// Standalone turbine header compiler used by Soong. This compiles all sources
// directly via turbine-defaults instead of statically linking turbine-core to
// avoid serializing host javac compilation steps on the critical build path.
java_library_host {
    name: "turbine",
    defaults: ["turbine-defaults"],

    srcs: [
        "proto/**/*.proto",
    ],

    manifest: "manifest.txt",

    proto: {
        type: "full",
    },
}
